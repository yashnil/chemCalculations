{
  "data": {
    "train_frac": 0.85,
    "val_frac": 0.1,
    "test_frac": 0.05,
    "target_topk_species": 20,
    "include_fz_as_feature": true,
    "use_static_species_list": true,
    "static_species_list_path": "static_species_list_32.json",
    "input_cols_manual": null,
    "target_cols_manual": null,
    "csv_path": "data/datasets/all_gas_fastchem_x3680.csv"
  },
  "optimization": {
    "epochs": 200,
    "batch_size": 512,
    "learning_rate": 0.0005,
    "weight_decay": 1e-05,
    "grad_clip": 5.0,
    "seed": 42
  },
  "architecture": {
    "latent_dim": 192,
    "encoder_hidden": [
      512,
      512,
      512
    ],
    "dynamics_hidden": [
      512,
      512,
      512
    ],
    "decoder_hidden": [
      512,
      512,
      512
    ],
    "activation": "silu",
    "dropout": 0.0
  },
  "loss": {
    "type": "log_ratio",
    "use_weighted": true
  },
  "normalization": {
    "temp_divisor": 4000.0,
    "input_log_scale": 10.0,
    "abund_epsilon_offset": 12.0,
    "abund_dex_scale": 10.0,
    "target_zero_floor": 1e-30,
    "target_log_scale": 30.0,
    "log_eps": 1e-30
  },
  "scheduler": {
    "type": "ReduceLROnPlateau",
    "mode": "min",
    "factor": 0.5,
    "patience": 10,
    "min_lr": 1e-06
  }
}